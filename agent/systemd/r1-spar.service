[Unit]
Description=星期一 陪练: DeepSeek plays the owner, her local model answers, the judged answers become training data
After=network-online.target r1-llm-daemon.service

[Service]
Type=oneshot
User=youyeetoo
Group=youyeetoo
WorkingDirectory=/userdata/agent
Environment=PYTHONPATH=/userdata/agent
Environment=MONDAY_USAGE_TAG=陪练
EnvironmentFile=-/userdata/secrets/deepseek.env
ExecStart=/usr/bin/flock -n -E 0 /tmp/monday-spar.lock /usr/bin/python3 -m learning.spar --minutes 150 --max-yuan 3 --max-turns 300
StandardOutput=append:/userdata/agent/logs/spar.log
StandardError=append:/userdata/agent/logs/spar.log
TimeoutStartSec=4h
Nice=10
