[Unit]
Description=星期一 发散: builds her association graph from the day's talk and wanders from a few seeds
After=network-online.target r1-llm-daemon.service

[Service]
Type=oneshot
User=youyeetoo
Group=youyeetoo
WorkingDirectory=/userdata/agent
Environment=PYTHONPATH=/userdata/agent
Environment=MONDAY_USAGE_TAG=发散
EnvironmentFile=-/userdata/secrets/deepseek.env
ExecStart=/usr/bin/flock -n -E 0 /tmp/monday-spar.lock /usr/bin/python3 -m learning.associate --seeds 6
StandardOutput=append:/userdata/agent/logs/associate.log
StandardError=append:/userdata/agent/logs/associate.log
TimeoutStartSec=1h
Nice=10
